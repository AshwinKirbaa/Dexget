FISH_API_KEY=
FISH_VOICE_ID=
FISH_MODEL=s2.1-pro-free
VOICE_PROVIDER=windows
VOICE_MODE=CONTINUOUS
WAKE_WORD=jarvis
MIC_DEVICE_INDEX=
SPEAKER_DEVICE_INDEX=
JARVIS_DEFAULT_BRAVE_ACCOUNT=combatmaster7777@gmail.com

# Jev Semantic Classifier
TYPESAFE_API_KEY=
JARVIS_JEV_MODE=active
JARVIS_SEMANTIC_TIMEOUT_SECONDS=2
JARVIS_JEV_AUTO_EXECUTE_THRESHOLD=0.85
JARVIS_JEV_AGENT_THRESHOLD=0.60
JARVIS_JEV_CACHE_TTL_SECONDS=300

# Local inference: no paid API calls unless explicitly selected.
JARVIS_LLM_PROVIDER=ollama
JARVIS_OLLAMA_MODEL=gemma3:4b
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_AUTO_PULL_MODEL=true
JARVIS_OLLAMA_START_TIMEOUT=30
JARVIS_OLLAMA_WARM_TIMEOUT=300
JARVIS_MODEL_TIMEOUT=300
JARVIS_LLM_TEMPERATURE=0.5
JARVIS_MAX_STEPS=40

# All paths accessible to your Windows account, or semicolon-separated roots.
JARVIS_FS_ROOT=*
JARVIS_REQUIRE_CONFIRMATION=true

# Optional Tailscale-only remote server (SSH key, never a password).
JARVIS_SERVER_NAME=ashwinserver
JARVIS_SERVER_HOST=100.106.129.0
JARVIS_SERVER_USER=ashwin_server
JARVIS_SERVER_SSH_KEY=%USERPROFILE%\.ssh\ashwinserver_ed25519
JARVIS_SERVER_ROOT=/opt/homeserver

# Dedicated persistent automation profile (blank uses the default).
JARVIS_BROWSER=chrome
JARVIS_BROWSER_PROFILE=
# "dedicated" avoids recurring remote-control consent. "attach" is legacy
# attachment to a daily browser profile and may prompt on every session.
JARVIS_BROWSER_SESSION_MODE=dedicated
JARVIS_VOSK_MODEL=
JARVIS_WHISPER_ENABLED=false
